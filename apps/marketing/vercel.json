{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/@:handle",
      "destination": "https://synara-profiles.vercel.app/@:handle"
    },
    {
      "source": "/profiles-assets/:path*",
      "destination": "https://synara-profiles.vercel.app/:path*"
    }
  ]
}
