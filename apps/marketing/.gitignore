# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli
/output
/playwright-report/
/test-results/
# capture-visual-matrix.mjs scratch output (dev tooling only, never committed)
/tests/visual/evidence/

# next.js
/.next/
/out/
/.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (opennext)
/.open-next/
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
