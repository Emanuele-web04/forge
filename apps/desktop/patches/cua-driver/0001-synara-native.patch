+fn with_restoration<T>(restore: impl FnOnce(), body: impl FnOnce() -> T) -> T {
+    struct Restore<F: FnOnce()>(Option<F>);
+    impl<F: FnOnce()> Drop for Restore<F> {
+        fn drop(&mut self) {
+            if let Some(restore) = self.0.take() {
+                restore();
+            }
+        }
+    }
+    let _restore = Restore(Some(restore));
+    body()
