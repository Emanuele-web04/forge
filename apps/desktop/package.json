{
  "name": "@synara/desktop",
  "version": "0.8.3",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript-native.tsbuildinfo",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "betterwright": "2.4.0",
    "effect": "catalog:",
    "electron": "43.4.1",
    "electron-updater": "^6.6.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@synara/contracts": "workspace:*",
    "@synara/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "Synara"
}
