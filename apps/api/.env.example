# Postgres connection string used by Drizzle.
# Matches the docker-compose.yml defaults (postgres:18).
DATABASE_URL=postgres://synara:synara@localhost:5432/synara_accounts

# --- WorkOS AuthKit ---
# Identity lives in WorkOS: this service stores no passwords and no user rows.
# Both values come from the WorkOS dashboard.

# Secret API key (starts with sk_). Server-side only — never ship it to a client.
WORKOS_API_KEY=

# Client id for the AuthKit application (starts with client_).
WORKOS_CLIENT_ID=

# Public base URL of this account service.
ACCOUNT_BASE_URL=http://localhost:8788

# Port the HTTP server listens on. Defaults to 8788 if unset.
PORT=8788

# --- WorkOS overrides ---
# Only needed to point at something other than the real WorkOS API; the test
# suite sets these to an in-process stand-in. Leave unset in production.

# WorkOS API origin. Defaults to https://api.workos.com.
# WORKOS_API_URL=

# Full JWKS URL. Defaults to {WORKOS_API_URL}/sso/jwks/{WORKOS_CLIENT_ID}.
# WORKOS_JWKS_URL=
