# Postgres connection string used by Drizzle and BetterAuth.
# Matches the docker-compose.yml defaults (postgres:18).
DATABASE_URL=postgres://synara:synara@localhost:5432/synara_accounts

# Secret used by BetterAuth to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of this account service (used for OAuth callback URLs, etc).
ACCOUNT_BASE_URL=http://localhost:8788

# Port the HTTP server listens on. Defaults to 8788 if unset.
PORT=8788

# --- Social sign-in providers ---
# Each provider only activates when BOTH its client id and secret are set.

# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (Sign in with Apple) credentials.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Microsoft OAuth (Entra ID) credentials.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Email delivery ---
# Resend API key used to send transactional email (verification, reset, etc).
RESEND_API_KEY=

# Alternative SMTP connection string, used if Resend is not configured.
SMTP_URL=

# From address used for outgoing account emails.
EMAIL_FROM=

# --- Signup restriction ---
# Comma-separated allowlist of emails permitted to sign up. Leave unset to allow anyone.
ACCOUNT_ALLOWED_SIGNUP_EMAILS=
