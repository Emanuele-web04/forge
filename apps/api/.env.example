# Postgres connection string used by Drizzle.
# Matches the docker-compose.yml defaults (postgres:18).
DATABASE_URL=postgres://synara:synara@localhost:5432/synara_accounts

# Which identity provider backs the adapter seam. Unset or "workos" (the
# default) is the real provider; "dev" is the offline development provider —
# it prints OTP codes to stdout and REFUSES to start with NODE_ENV=production
# or while WORKOS_API_KEY is set. Never set "dev" in a deployment.
# IDENTITY_PROVIDER=

# --- WorkOS AuthKit ---
# Identity lives in WorkOS: this service stores no passwords and no user rows.
# Both values come from the WorkOS dashboard.

# Secret API key (starts with sk_). Server-side only — never ship it to a client.
WORKOS_API_KEY=

# Client id for the AuthKit application (starts with client_).
WORKOS_CLIENT_ID=

# Public base URL of this account service.
ACCOUNT_BASE_URL=http://localhost:8788

# Exact public API issuer/origin used in host/device JWT audiences and iss.
API_PUBLIC_URL=http://localhost:8788/api/v1

# Base64url-encoded 32-byte Ed25519 seed for grants, relay tickets, and JWKS.
# Required with WorkOS. Dev mode generates an ephemeral key and warns if unset.
API_SIGNING_KEY=

# Previous signing seed kept in JWKS during a key rotation. Verification-only.
# API_SIGNING_KEY_PREVIOUS=

# Shared secret authenticating the relay's /internal requests. Required with WorkOS.
RELAY_SERVICE_TOKEN=

# Port the HTTP server listens on. Defaults to 8788 if unset.
PORT=8788

# How many proxies in front of this service append to x-forwarded-for.
# Defaults to 0: trust only the socket address — the safe value for a
# direct/Docker self-host, where any caller can send the header and a
# trusted hop would let them rotate forged IPs past every per-IP rate
# budget. Behind a TLS-terminating proxy the socket is the proxy, so set
# the hop count explicitly: Railway (and similar single-proxy platforms)
# need TRUSTED_PROXY_HOPS=1.
# TRUSTED_PROXY_HOPS=1

# Shared secret authenticating the profiles SSR deployment (apps/profiles)
# to this API. When set, a GET /profiles/:handle request carrying a matching
# x-synara-proxy-secret header has its rate limit keyed on the
# x-synara-viewer-ip header it forwards — per-visitor budgets instead of one
# shared bucket for the SSR egress IP. Rate-limit keying only, never
# authentication. Unset, the viewer header is ignored entirely.
# PROFILE_PROXY_SECRET=

# --- Avatar storage (S3-compatible, optional) ---
# Where uploaded profile avatars live: any S3-compatible object store —
# Cloudflare R2, MinIO, AWS S3, … — addressed path-style through S3_ENDPOINT.
# All five variables are optional AS A SET: leave them all unset to run
# without avatar uploads (the upload routes answer 503, nothing else is
# affected). A partial set refuses to start, so a typo cannot silently
# disable uploads in production.

# S3 API endpoint origin, e.g. https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT=

# Bucket the avatars are written to.
# S3_BUCKET=

# Access key pair for the bucket. Server-side only.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Public origin the bucket is served from (CDN or custom domain, no trailing
# slash); avatar URLs are ${S3_PUBLIC_BASE_URL}/${object key}.
# S3_PUBLIC_BASE_URL=

# SigV4 signing region. Optional — defaults to "auto", the spelling R2
# requires and MinIO accepts. Real AWS S3 rejects "auto": set the bucket's
# actual region (e.g. us-east-1) there.
# S3_REGION=

# --- WorkOS overrides ---
# Only needed to point at something other than the real WorkOS API; the test
# suite sets these to an in-process stand-in. Leave unset in production.
#
# The expected issuer and the JWKS URL are NOT configured here by default: both
# are read from WorkOS's OIDC metadata document at
# {WORKOS_API_URL}/user_management/{WORKOS_CLIENT_ID}/.well-known/openid-configuration
# on the first token verification, and cached for the process lifetime. That
# document is the only authority on the issuer — WorkOS scopes `iss` to the
# *environment's* client id, which is not WORKOS_CLIENT_ID when the app is a
# non-default AuthKit application.

# WorkOS API origin. Defaults to https://api.workos.com.
# WORKOS_API_URL=

# Full JWKS URL. Overrides the discovered `jwks_uri`. Set only for a stand-in.
# WORKOS_JWKS_URL=

# Expected `iss` claim on access tokens. Overrides the discovered `issuer`. Set
# only for a custom auth domain or a stand-in that serves no metadata document.
# WORKOS_ISSUER=
