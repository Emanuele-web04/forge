+export interface CapturePage {
+  isClosed(): boolean;
+  once(event: "close", callback: () => void): unknown;
+}
+export interface CaptureContext {
+  pages(): CapturePage[];
+  on(event: "page", callback: (page: CapturePage) => void): unknown;
+  off(event: "page", callback: (page: CapturePage) => void): unknown;
+  newCDPSession(page: CapturePage): Promise<{
+    send(method: string, params?: Record<string, unknown>): Promise<unknown>;
+    on(event: string, callback: (event: unknown) => void): unknown;
+    detach(): Promise<void>;
+  }>;
+}
+export function installVaultCapture(context: CaptureContext, deps: {
+  vaultCallAtOrigin(session: unknown, origin: string, action: string, payload: Record<string, unknown>): Promise<unknown>;
+  sessionForPage(page: CapturePage): unknown;
+  trackSecret(value: string): void;
+  isHeaded(): boolean;
+  lastModelActivity(page: CapturePage, origin: string): number;
+  shouldCapture?(input: { origin: string; username: string; password: string }): Promise<boolean>;
+  requestSave?(input: { page: CapturePage; origin: string; username: string; mode: string }): Promise<"save" | "dismiss">;
+  matchMode?: "exact-origin";
+  onError?(error: Error): void;
+  onReady?(): void;
+}): { dispose(): Promise<void>; isBusy(page: CapturePage): boolean };
